[
  {
    "ConfigFile": "server.properties",
    "ConfigType": "kvp",
    "ConfigFormat": "{0}{1}",
    "Importable": true,
    "Subsections": [
      {
        "Heading": "$root",
        "SettingMappings": {
          "server-port=": "$ServerPort",
          "server-ip=": "$ApplicationIPBinding",
          "max-players=": "$MaxUsers"
        }
      }
    ]
  },
  {
    "ConfigFile": "eula.txt",
    "ConfigType": "kvp",
    "ConfigFormat": "{0}{1}",
    "Importable": true,
    "Subsections": [
      {
        "Heading": "$root",
        "SettingMappings": {
          "eula=": "AcceptEula"
        }
      }
    ]
  }
]
