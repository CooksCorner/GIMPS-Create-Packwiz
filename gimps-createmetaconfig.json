  {
    "ConfigFile": "eula.txt",
    "ConfigType": "kvp",
    "ConfigFormat": "{0}{1}",
    "Importable": true,
    "Subsections": [
      {
        "Heading": "$root",
        "SettingMappings": {
          "eula=": "AcceptEula"
        }
      }
    ]
  }
]
